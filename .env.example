# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed.

# Supabase project (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OMDB API key (free at https://www.omdbapi.com/apikey.aspx)
VITE_OMDB_API_KEY=your-omdb-api-key

# TMDB API key, used only for "where to watch" streaming availability
# (free at https://www.themoviedb.org/settings/api - use the "API Key (v3 auth)" value)
VITE_TMDB_API_KEY=your-tmdb-api-key
